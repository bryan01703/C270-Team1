<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <%- include('../partials/nav') %>

  <main class="page-content">
    <h1>Grade Tracker</h1>

    <section class="card">
      <h2>Current GPA</h2>
      <p style="font-size: 3rem; font-weight: bold;">
        <%= gpa %>
      </p>
    </section>

    <% modules.forEach(module => { %>
      <section class="card">
        <h2>
          <%= module.module_code %> -
          <%= module.module_name %>
        </h2>

        <p>
          Current weighted score:
          <strong>
            <%= module.currentPercentage.toFixed(2) %>%
          </strong>
        </p>

        <% if (!module.isComplete) { %>
          <% if (module.requiredScore <= 0) { %>
            <p style="color: green;">
              You have already secured an A.
            </p>
          <% } else if (module.requiredScore > 100) { %>
            <p style="color: red;">
              An A is no longer mathematically possible.
            </p>
          <% } else { %>
            <p>
              Required average in remaining assessments for an A:
              <strong>
                <%= module.requiredScore.toFixed(2) %>%
              </strong>
            </p>
          <% } %>
        <% } else if (module.finalGrade) { %>
          <p>
            Final grade:
            <strong>
              <%= module.finalGrade.letter_grade %>
            </strong>
          </p>
        <% } %>

        <table>
          <thead>
            <tr>
              <th>Assessment</th>
              <th>Weight</th>
              <th>Score</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% module.assessments.forEach(assessment => { %>
              <tr>
                <form action="/grades/save" method="POST">
                  <td>
                    <%= assessment.assessment_name %>
                  </td>

                  <td>
                    <%= assessment.weight %>%
                  </td>

                  <td>
                    <input
                      type="number"
                      name="score"
                      min="0"
                      step="0.01"
                      value="<%= assessment.score ?? '' %>"
                      placeholder="Score"
                      required
                    >

                    <input
                      type="number"
                      name="maximum_score"
                      min="0.01"
                      step="0.01"
                      value="<%= assessment.maximum_score ?? '' %>"
                      placeholder="Maximum"
                      required
                    >
                  </td>

                  <td>
                    <input
                      type="hidden"
                      name="module_code"
                      value="<%= module.module_code %>"
                    >

                    <input
                      type="hidden"
                      name="assessment_code"
                      value="<%= assessment.assessment_code %>"
                    >

                    <button type="submit">
                      Save
                    </button>
                </form>

                <% if (assessment.score !== null) { %>
                  <form action="/grades/delete" method="POST">
                    <input
                      type="hidden"
                      name="module_code"
                      value="<%= module.module_code %>"
                    >

                    <input
                      type="hidden"
                      name="assessment_code"
                      value="<%= assessment.assessment_code %>"
                    >

                    <button type="submit">
                      Delete
                    </button>
                  </form>
                <% } %>
                  </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% }) %>
  </main>
</body>
</html>