<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %> - StudyHub</title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/announcement-form.css">
</head>

<body>
  <%- include('partials/nav') %>

  <main class="announcement-form-page">
    <div class="announcement-form-header">
      <div>
        <p class="form-eyebrow">
          Announcement Management
        </p>

        <h1>
          <%= title %>
        </h1>

        <p>
          Share important updates with your classmates.
        </p>
      </div>

      <a
        href="/announcements"
        class="back-button"
      >
        Back to Announcements
      </a>
    </div>

    <section class="announcement-form-card">
      <%
        const editing = Boolean(locals.isEdit);
        const currentAnnouncement =
          locals.announcement || {};
      %>

      <% if (locals.error) { %>
        <div class="form-error">
          <%= error %>
        </div>
      <% } %>

      <form
        action="<%= editing
          ? '/announcements/' +
            currentAnnouncement.announcement_id +
            '/edit'
          : '/announcements' %>"
        method="POST"
        class="announcement-form"
      >
        <div class="form-section-heading">
          <h2>
            <%= editing
              ? 'Edit Announcement'
              : 'Create Announcement' %>
          </h2>

          <p>
            Fields marked with
            <span>*</span>
            are required.
          </p>
        </div>

        <div class="form-group full-width">
          <label for="title">
            Announcement Title
            <span>*</span>
          </label>

          <input
            id="title"
            type="text"
            name="title"
            maxlength="255"
            placeholder="Enter an announcement title"
            value="<%= editing
              ? currentAnnouncement.title
              : '' %>"
            required
          >
        </div>

        <div class="form-group full-width">
          <label for="content">
            Announcement Content
            <span>*</span>
          </label>

          <textarea
            id="content"
            name="content"
            rows="7"
            placeholder="Write your announcement here..."
            required
          ><%= editing
            ? currentAnnouncement.content
            : '' %></textarea>

          <small>
            Keep your message clear and easy to understand.
          </small>
        </div>

        <div class="form-group">
          <label for="module_code">
            Module
            <span>*</span>
          </label>

          <select
            id="module_code"
            name="module_code"
            required
          >
            <option value="">
              Select a module
            </option>

            <% modules.forEach(module => { %>
              <option
                value="<%= module.code %>"
                <%= editing &&
                  currentAnnouncement.module_code ===
                  module.code
                  ? 'selected'
                  : '' %>
              >
                <%= module.code %> -
                <%= module.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="class_section">
            Class Section
          </label>

          <input
            id="class_section"
            type="text"
            name="class_section"
            placeholder="Example: C270-010"
            value="<%= editing
              ? currentAnnouncement.class_section
              : 'All' %>"
          >
        </div>

        <div class="form-group">
          <label for="priority">
            Priority
            <span>*</span>
          </label>

          <select
            id="priority"
            name="priority"
            required
          >
            <% ['Low', 'Normal', 'High'].forEach(priority => { %>
              <option
                value="<%= priority %>"
                <%= editing &&
                  currentAnnouncement.priority === priority
                  ? 'selected'
                  : '' %>
              >
                <%= priority %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-preview">
          <p class="preview-label">
            Priority Preview
          </p>

          <span
            id="priorityPreview"
            class="priority-preview priority-normal"
          >
            Normal
          </span>
        </div>

        <div class="form-actions full-width">
          <a
            href="/announcements"
            class="cancel-button"
          >
            Cancel
          </a>

          <button
            type="submit"
            class="submit-button"
          >
            <%= editing
              ? 'Save Changes'
              : 'Post Announcement' %>
          </button>
        </div>
      </form>
    </section>
  </main>

  <script>
    // Updates the priority preview when the priority changes.
    const prioritySelect =
      document.getElementById('priority');

    const priorityPreview =
      document.getElementById('priorityPreview');

    function updatePriorityPreview() {
      const selectedPriority =
        prioritySelect.value.toLowerCase();

      priorityPreview.textContent =
        prioritySelect.value;

      priorityPreview.className =
        `priority-preview priority-${selectedPriority}`;
    }

    prioritySelect.addEventListener(
      'change',
      updatePriorityPreview
    );

    updatePriorityPreview();
  </script>
</body>
</html>