<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> - StudyHub
  </title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <%- include('partials/nav') %>

    <main>
      <div class="card">

        <h1>Edit Study Session</h1>

        <% if (locals.error) { %>
          <div class="alert alert-error">
            <%= error %>
          </div>
          <% } %>

            <form action="/studygroups/<%= group.group_id %>/edit" method="POST">

              <div class="form-group">
                <label for="group_name">Session Title</label>
                <input type="text" id="group_name" name="group_name" value="<%= group.group_name %>" required>
              </div>

              <div class="form-group">
                <label for="module_code">Module</label>

                <select id="module_code" name="module_code" required>

                  <% modules.forEach(function(m){ %>

                    <option value="<%= m.code %>" <%=group.module_code===m.code ? 'selected' : '' %>>

                      <%= m.code %> — <%= m.name %>

                    </option>

                    <% }) %>

                </select>

              </div>

              <div class="form-group">
                <label for="session_date">Date</label>

                <input type="date" id="session_date" name="session_date" value="<%= group.session_date %>" required>

              </div>

              <div class="form-group">
                <label for="session_time">Time</label>

                <input type="text" id="session_time" name="session_time" value="<%= group.session_time %>" required>

              </div>

              <div class="form-group">
                <label for="location">Location</label>

                <input type="text" id="location" name="location" value="<%= group.location %>" required>

              </div>

              <div class="form-group">
                <label for="session_link">Online Link</label>

                <input type="text" id="session_link" name="session_link" value="<%= group.session_link %>">

              </div>

              <div class="form-group">
                <label for="max_slots">Slots Available</label>

                <input type="number" id="max_slots" name="max_slots" min="1" max="50" value="<%= group.max_slots %>"
                  required>

              </div>

              <div class="form-group">
                <label for="description">Description</label>

                <textarea id="description" name="description" rows="3"><%= group.description %></textarea>

              </div>

              <div class="action-buttons">

                <button type="submit" class="btn">
                  Save Changes
                </button>

                <a href="/studygroups/<%= group.group_id %>" class="btn btn-secondary">
                  Cancel
                </a>
              </div>

            </form>

      </div>
    </main>

</body>

</html>