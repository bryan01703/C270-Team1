<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - StudyHub</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="card">
      <h1>My Profile</h1>

      <% if (locals.success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>
      <% if (locals.error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <div class="profile-info mb-2">
        <p><strong>Username:</strong> <span><%= user.username %></span></p>
        <p><strong>Name:</strong> <span><%= user.full_name %></span></p>
        <p><strong>Role:</strong> <span class="role-badge role-<%= user.role_type.toLowerCase() %>"><%= user.role_type %></span></p>
        <p><strong>Joined:</strong> <span><%= user.created_at %></span></p>
        <% if (user.bio) { %>
          <p><strong>Bio:</strong> <span><%= user.bio %></span></p>
        <% } %>
        <% if (user.role_type === 'Student' || user.role_type === 'Teacher') { %>
          <div class="class-codes-display">
            <strong>Enrolled Classes:</strong>
            <div class="module-grid">
              <%
                var allModules = [
                  { code: 'C218', name: 'UI/UX Design for Apps' },
                  { code: 'C240', name: 'AI Essentials and Innovations' },
                  { code: 'C245', name: 'Data Intelligence and Visualisation' },
                  { code: 'C246', name: 'Data Analytics with GenAI' },
                  { code: 'C257', name: 'Fundamentals of Design' },
                  { code: 'C270', name: 'DevOps Essentials' },
                  { code: 'C304', name: 'Cloud Application Development' },
                  { code: 'C339', name: 'Software Testing and Analytics' },
                  { code: 'C346', name: 'Mobile App Development' },
                  { code: 'C390', name: 'Portfolio Development' }
                ];
                var savedCodes = (user.class_codes || '').split(',').map(function(c) { return c.trim(); });
              %>
              <% allModules.forEach(function(mod) { %>
                <%
                  var matched = savedCodes.filter(function(c) { return c.indexOf(mod.code) === 0; });
                  var display = matched.length > 0 ? matched.join(', ') : 'Not Enrolled';
                %>
                <div class="module-grid-item<%= matched.length > 0 ? ' enrolled' : '' %>">
                  <span class="module-grid-code"><%= mod.code %></span>
                  <span class="module-grid-name"><%= mod.name %></span>
                  <span class="module-grid-class"><%= display %></span>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>

      <div class="role-actions mb-2">
        <% if (user.role_type === 'Student') { %>
          <a href="#" class="btn" onclick="alert('Homework tasks page coming soon!'); return false;">View Homework Tasks</a>
        <% } else if (user.role_type === 'Teacher') { %>
          <a href="#" class="btn" onclick="alert('Create Class Announcement feature coming soon!'); return false;">Create Class Announcement</a>
        <% } else if (user.role_type === 'Admin') { %>
          <a href="/admin/dashboard" class="btn btn-danger">Admin Control Panel</a>
        <% } %>
      </div>

      <hr class="mb-2">

      <h2 class="mb-1">Edit Profile</h2>

      <form action="/profile" method="POST">
        <div class="form-group">
          <label for="bio">Tell us about yourself!</label>
          <textarea id="bio" name="bio" rows="3" placeholder="Tell us about yourself (e.g., your interests, coding goals, or a short bio)"><%= user.bio || '' %></textarea>
        </div>

        <% if (user.role_type === 'Student' || user.role_type === 'Teacher') { %>
          <% var codes = (user.class_codes || '').split(',').map(function(c) { return c.trim(); }); %>
          <div class="form-group">
            <label>Select your class code for each module this semester:</label>
            <div class="module-select-group">
              <div class="module-select-item">
                <label for="class_codes_C218">C218 — UI/UX Design for Apps</label>
                <select id="class_codes_C218" name="class_codes_C218">
                  <option value="">-- Not taking --</option>
                  <option value="C218-010" <%= codes.indexOf('C218-010') !== -1 ? 'selected' : '' %>>C218-010</option>
                  <option value="C218-020" <%= codes.indexOf('C218-020') !== -1 ? 'selected' : '' %>>C218-020</option>
                  <option value="C218-030" <%= codes.indexOf('C218-030') !== -1 ? 'selected' : '' %>>C218-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C240">C240 — AI Essentials and Innovations</label>
                <select id="class_codes_C240" name="class_codes_C240">
                  <option value="">-- Not taking --</option>
                  <option value="C240-010" <%= codes.indexOf('C240-010') !== -1 ? 'selected' : '' %>>C240-010</option>
                  <option value="C240-020" <%= codes.indexOf('C240-020') !== -1 ? 'selected' : '' %>>C240-020</option>
                  <option value="C240-030" <%= codes.indexOf('C240-030') !== -1 ? 'selected' : '' %>>C240-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C245">C245 — Data Intelligence and Visualisation</label>
                <select id="class_codes_C245" name="class_codes_C245">
                  <option value="">-- Not taking --</option>
                  <option value="C245-010" <%= codes.indexOf('C245-010') !== -1 ? 'selected' : '' %>>C245-010</option>
                  <option value="C245-020" <%= codes.indexOf('C245-020') !== -1 ? 'selected' : '' %>>C245-020</option>
                  <option value="C245-030" <%= codes.indexOf('C245-030') !== -1 ? 'selected' : '' %>>C245-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C246">C246 — Data Analytics with GenAI</label>
                <select id="class_codes_C246" name="class_codes_C246">
                  <option value="">-- Not taking --</option>
                  <option value="C246-010" <%= codes.indexOf('C246-010') !== -1 ? 'selected' : '' %>>C246-010</option>
                  <option value="C246-020" <%= codes.indexOf('C246-020') !== -1 ? 'selected' : '' %>>C246-020</option>
                  <option value="C246-030" <%= codes.indexOf('C246-030') !== -1 ? 'selected' : '' %>>C246-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C257">C257 — Fundamentals of Design</label>
                <select id="class_codes_C257" name="class_codes_C257">
                  <option value="">-- Not taking --</option>
                  <option value="C257-010" <%= codes.indexOf('C257-010') !== -1 ? 'selected' : '' %>>C257-010</option>
                  <option value="C257-020" <%= codes.indexOf('C257-020') !== -1 ? 'selected' : '' %>>C257-020</option>
                  <option value="C257-030" <%= codes.indexOf('C257-030') !== -1 ? 'selected' : '' %>>C257-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C270">C270 — DevOps Essentials</label>
                <select id="class_codes_C270" name="class_codes_C270">
                  <option value="">-- Not taking --</option>
                  <option value="C270-010" <%= codes.indexOf('C270-010') !== -1 ? 'selected' : '' %>>C270-010</option>
                  <option value="C270-020" <%= codes.indexOf('C270-020') !== -1 ? 'selected' : '' %>>C270-020</option>
                  <option value="C270-030" <%= codes.indexOf('C270-030') !== -1 ? 'selected' : '' %>>C270-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C304">C304 — Cloud Application Development</label>
                <select id="class_codes_C304" name="class_codes_C304">
                  <option value="">-- Not taking --</option>
                  <option value="C304-010" <%= codes.indexOf('C304-010') !== -1 ? 'selected' : '' %>>C304-010</option>
                  <option value="C304-020" <%= codes.indexOf('C304-020') !== -1 ? 'selected' : '' %>>C304-020</option>
                  <option value="C304-030" <%= codes.indexOf('C304-030') !== -1 ? 'selected' : '' %>>C304-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C339">C339 — Software Testing and Analytics</label>
                <select id="class_codes_C339" name="class_codes_C339">
                  <option value="">-- Not taking --</option>
                  <option value="C339-010" <%= codes.indexOf('C339-010') !== -1 ? 'selected' : '' %>>C339-010</option>
                  <option value="C339-020" <%= codes.indexOf('C339-020') !== -1 ? 'selected' : '' %>>C339-020</option>
                  <option value="C339-030" <%= codes.indexOf('C339-030') !== -1 ? 'selected' : '' %>>C339-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C346">C346 — Mobile App Development</label>
                <select id="class_codes_C346" name="class_codes_C346">
                  <option value="">-- Not taking --</option>
                  <option value="C346-010" <%= codes.indexOf('C346-010') !== -1 ? 'selected' : '' %>>C346-010</option>
                  <option value="C346-020" <%= codes.indexOf('C346-020') !== -1 ? 'selected' : '' %>>C346-020</option>
                  <option value="C346-030" <%= codes.indexOf('C346-030') !== -1 ? 'selected' : '' %>>C346-030</option>
                </select>
              </div>
              <div class="module-select-item">
                <label for="class_codes_C390">C390 — Portfolio Development</label>
                <select id="class_codes_C390" name="class_codes_C390">
                  <option value="">-- Not taking --</option>
                  <option value="C390-010" <%= codes.indexOf('C390-010') !== -1 ? 'selected' : '' %>>C390-010</option>
                  <option value="C390-020" <%= codes.indexOf('C390-020') !== -1 ? 'selected' : '' %>>C390-020</option>
                  <option value="C390-030" <%= codes.indexOf('C390-030') !== -1 ? 'selected' : '' %>>C390-030</option>
                </select>
              </div>
            </div>
            <small class="helper-text">&#128161; Where do I find this? Check your <a href="#" onclick="alert('Open SNApp &#8594; Timetable or Attendance screen. Your module class code (e.g., C218-030) appears next to each scheduled module.'); return false;">SNApp timetable or attendance screen</a>! Your code (e.g., C218-030) is listed right next to your scheduled modules.</small>
          </div>
        <% } %>

        <button type="submit" class="btn">Save Changes</button>
      </form>

      <p class="mt-2 text-center"><a href="/profile">&larr; Go Back</a></p>
    </div>
  </main>
</body>
</html>
