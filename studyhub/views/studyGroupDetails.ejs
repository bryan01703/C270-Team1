<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <title>Study Groups</title>
</head>

<body>
    <div class="container mt-5">
        <h2 class="mb-4">Study Groups</h2>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Group Name</th>
                        <th>Module</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Location</th>
                        <th>Members</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < studyGroups.length; i++) { %>
                    <tr>
                        <td><%= studyGroups[i].groupName %></td>
                        <td><%= studyGroups[i].module %></td>
                        <td><%= studyGroups[i].date %></td>
                        <td><%= studyGroups[i].time %></td>
                        <td><%= studyGroups[i].location %></td>
                        <td><%= studyGroups[i].members %></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card bg-light border-0 shadow-sm p-4 mb-4">
            <h5 class="text-primary mb-3">About This Session</h5>
            <p class="fs-5 text-dark mb-0">
                <%= studyGroups[i].description %>
            </p>
        </div>

        <div class="d-flex justify-content-end">
            <button class="btn btn-success btn-lg px-5" onclick="alert('Joined successfully!')">Join Group</button>
        </div>

        <% } %></div>
</body>
</html>