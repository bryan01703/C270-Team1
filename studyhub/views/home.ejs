<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - StudyHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/home.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('partials/nav') %>

  <!-- Hero -->
  <div class="hero">
    <div class="hero-content">
      <div class="hero-tag">🎓 Republic Polytechnic · School of Infocomm</div>
      <h1 class="hero-title">Welcome back, <span><%= user.full_name.split(' ')[0] %></span> 👋</h1>
      <p class="hero-sub">Here's your academic overview for today.</p>
      <div class="hero-date" id="heroDate"></div>
    </div>
  </div>

  <div class="home-page">

  <!-- Deadline Alert Banner -->
<%
  const soonTasks = upcomingTasks.filter(t => {
    const due = new Date(t.due_date);
    const today = new Date(); today.setHours(0,0,0,0);
    const diff = Math.ceil((due - today) / (1000*60*60*24));
    return diff >= 0 && diff <= 7;
  });
  const soonOfficial = (officialDeadlines || []).filter(od => {
    const due = new Date(od.due_date);
    const today = new Date(); today.setHours(0,0,0,0);
    const diff = Math.ceil((due - today) / (1000*60*60*24));
    return diff >= 0 && diff <= 7;
  });
  const totalSoon = soonTasks.length + soonOfficial.length;
%>
<% if (totalSoon > 0) { %>
<div id="deadlineBanner" style="
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  color: #fff;
  padding: 0.85rem 1.5rem;
  border-radius: 12px;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4px 14px rgba(99,102,241,0.3);
">
  <div style="display: flex; align-items: center; gap: 0.75rem;">
    <span style="font-size: 1.3rem;">⚠️</span>
    <div>
      <div style="font-weight: 700; font-size: 0.95rem;">
        You have <%= totalSoon %> deadline<%= totalSoon > 1 ? 's' : '' %> coming up this week!
      </div>
      <div style="font-size: 0.8rem; opacity: 0.85; margin-top: 0.15rem;">
        <% if (soonOfficial.length > 0 && soonTasks.length > 0) { %>
          <%= soonOfficial.length %> official · <%= soonTasks.length %> personal
        <% } else if (soonOfficial.length > 0) { %>
          <%= soonOfficial.length %> official
        <% } else { %>
          <%= soonTasks.length %> personal
        <% } %>
      </div>
    </div>
  </div>
  <button onclick="document.getElementById('deadlineBanner').style.display='none'" style="
    background: rgba(255,255,255,0.2);
    border: none;
    color: #fff;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
  ">Dismiss</button>
</div>
<% } %>

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon red">🔴</div>
        <div class="stat-info">
          <div class="stat-num"><%= overdue %></div>
          <div class="stat-label">Overdue</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon yellow">⏰</div>
        <div class="stat-info">
          <div class="stat-num"><%= dueSoon %></div>
          <div class="stat-label">Due This Week</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon green">✅</div>
        <div class="stat-info">
          <div class="stat-num"><%= done %></div>
          <div class="stat-label">Completed</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon blue">📋</div>
        <div class="stat-info">
          <div class="stat-num"><%= total %></div>
          <div class="stat-label">Total Tasks</div>
        </div>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="main-grid">

      <div>

        <!-- Official Deadlines (pinned) -->
        <% if (officialDeadlines && officialDeadlines.length > 0) { %>
        <div class="card" style="background:#fff8f8; border: 1.5px solid #fecaca; margin-bottom: 1.2rem;">
          <div class="card-header">
            <div class="card-title">
              <div class="card-title-dot" style="background:#ef4444"></div>
              📌 Official Deadlines
            </div>
            <a href="/tasks" class="card-link" style="color:#ef4444">View all →</a>
          </div>
          <% officialDeadlines.forEach(od => { %>
            <%
              const today = new Date(); today.setHours(0,0,0,0);
              const due = new Date(od.due_date);
              const diff = Math.ceil((due - today) / (1000*60*60*24));
              const dotClass = diff <= 3 ? 'red' : diff <= 7 ? 'yellow' : 'grey';
              const badgeClass = diff <= 3 ? 'badge-red' : diff <= 7 ? 'badge-yellow' : 'badge-grey';
              const badgeText = diff <= 3 ? 'Due Soon' : due.toLocaleDateString('en-SG', { day: '2-digit', month: 'short' });
            %>
            <div class="task-item" style="border: 1px solid #fecaca; background:#fff;">
              <div class="task-dot <%= dotClass %>"></div>
              <div class="task-info">
                <div class="task-title"><%= od.title %></div>
                <div class="task-meta"><%= od.module %> · <%= od.deadline_type %> · by <%= od.created_by_name %></div>
              </div>
              <span class="task-badge" style="background:#fee2e2; color:#991b1b; margin-right: 0.3rem;">📢 Official</span>
              <span class="task-badge <%= badgeClass %>"><%= badgeText %></span>
            </div>
          <% }) %>
        </div>
        <% } %>

        <!-- My Deadlines -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <div class="card-title-dot"></div>
              My Deadlines
            </div>
            <a href="/tasks" class="card-link">View all →</a>
          </div>

          <% if (upcomingTasks.length === 0) { %>
            <div class="empty">
              <span class="empty-icon">✅</span>
              You're all clear — no upcoming tasks!
            </div>
          <% } else { %>
            <% upcomingTasks.forEach(task => { %>
              <%
                const today = new Date(); today.setHours(0,0,0,0);
                const due = new Date(task.due_date);
                const diff = Math.ceil((due - today) / (1000*60*60*24));
                const dotClass = diff < 0 ? 'red' : diff <= 3 ? 'yellow' : 'grey';
                const badgeClass = diff < 0 ? 'badge-red' : diff <= 3 ? 'badge-yellow' : 'badge-grey';
                const badgeText = diff < 0 ? 'Overdue' : diff <= 3 ? 'Due Soon' : due.toLocaleDateString('en-SG', { day: '2-digit', month: 'short' });
              %>
              <div class="task-item">
                <div class="task-dot <%= dotClass %>"></div>
                <div class="task-info">
                  <div class="task-title"><%= task.title %></div>
                  <div class="task-meta"><%= task.module %> · <%= task.task_type %></div>
                </div>
                <span class="task-badge <%= badgeClass %>"><%= badgeText %></span>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- Announcements -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">
              <div class="card-title-dot" style="background:#f59e0b"></div>
              Latest Announcements
            </div>
            <a href="/announcements" class="card-link">View all →</a>
          </div>
          <% if (announcements && announcements.length > 0) { %>
            <% announcements.forEach(a => { %>
              <div class="task-item">
                <div class="task-dot" style="background: <%= a.priority === 'High' ? '#ef4444' : a.priority === 'Medium' ? '#f59e0b' : '#94a3b8' %>"></div>
                <div class="task-info">
                  <div class="task-title"><%= a.title %></div>
                  <div class="task-meta"><%= a.module_code %> · <%= a.poster_name %></div>
                </div>
                <span class="task-badge <%= a.priority === 'High' ? 'badge-red' : a.priority === 'Medium' ? 'badge-yellow' : 'badge-grey' %>"><%= a.priority %></span>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty">
              <span class="empty-icon">📢</span>
              No announcements yet — check back soon.
            </div>
          <% } %>
        </div>

      </div>

      <!-- Quick Links -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <div class="card-title-dot" style="background:#10b981"></div>
            Quick Links
          </div>
        </div>
        <a href="/tasks" class="quick-link">
          <div class="ql-icon ic-1">📋</div> My Tasks
        </a>
        <a href="/announcements" class="quick-link">
          <div class="ql-icon ic-2">📢</div> Module Feed
        </a>
        <a href="/studygroups" class="quick-link">
          <div class="ql-icon ic-3">👥</div> Study Groups
        </a>
        <a href="/marketplace" class="quick-link">
          <div class="ql-icon ic-4">🛒</div> Marketplace
        </a>
        <a href="/profile" class="quick-link">
          <div class="ql-icon ic-5">👤</div> My Profile
        </a>
      </div>

    </div>
  </div>

  <script>
    const d = new Date();
    document.getElementById('heroDate').textContent = d.toLocaleDateString('en-SG', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
    });
  </script>
</body>
</html>