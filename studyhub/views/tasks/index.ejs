<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - StudyHub</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/nav') %>
  <main>
    <div class="card">
      <h1>My Tasks</h1>

      <% if (locals.error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (locals.success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <!-- Add Task Form -->
      <h2 class="mb-1">Add New Task</h2>
      <form action="/tasks/add" method="POST" class="mb-2">
        <div class="form-group">
          <label for="title">Task Title *</label>
          <input type="text" id="title" name="title" maxlength="100" required
            placeholder="e.g. Complete CA2 Report"
            value="<%= locals.form ? form.title || '' : '' %>">
          <small class="helper-text">Max 100 characters</small>
        </div>

        <div class="form-group">
          <label for="task_type">Task Type *</label>
          <select id="task_type" name="task_type" required>
            <option value="">-- Select type --</option>
            <% VALID_TASK_TYPES.forEach(t => { %>
              <option value="<%= t %>" <%= locals.form && form.task_type === t ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="module">Module *</label>
          <select id="module" name="module" required>
            <option value="">-- Select module --</option>
            <% VALID_MODULES.forEach(mod => { %>
              <option value="<%= mod %>" <%= locals.form && form.module === mod ? 'selected' : '' %>><%= mod %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="due_date">Due Date *</label>
          <input type="date" id="due_date" name="due_date" required
            min="<%= new Date().toISOString().split('T')[0] %>"
            value="<%= locals.form ? form.due_date || '' : '' %>">
        </div>

        <div class="form-group">
          <label for="status">Status *</label>
          <select id="status" name="status" required>
            <% VALID_STATUSES.forEach(s => { %>
              <option value="<%= s %>" <%= locals.form && form.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn">Add Task</button>
      </form>

      <hr class="mb-2">

      <!-- Filter Bar -->
      <h2 class="mb-1">My Task List</h2>
      <form method="GET" action="/tasks" class="filter-bar mb-2">
        <select name="status" onchange="this.form.submit()">
          <option value="">All Statuses</option>
          <% VALID_STATUSES.forEach(s => { %>
            <option value="<%= s %>" <%= selectedStatus === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <select name="module" onchange="this.form.submit()">
          <option value="">All Modules</option>
          <% VALID_MODULES.forEach(mod => { %>
            <option value="<%= mod %>" <%= selectedModule === mod ? 'selected' : '' %>><%= mod %></option>
          <% }) %>
        </select>
        <% if (selectedStatus || selectedModule) { %>
          <a href="/tasks" class="btn btn-secondary">Clear Filters</a>
        <% } %>
      </form>

      <!-- Task Table -->
      <% if (tasks.length === 0) { %>
        <p class="text-center">No tasks found. Add one above!</p>
      <% } else { %>
        <table class="task-table">
          <thead>
            <tr>
              <th>Task</th>
              <th>Type</th>
              <th>Module</th>
              <th>Due Date</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% tasks.forEach(task => { %>
              <%
                const today = new Date(); today.setHours(0,0,0,0);
                const due = new Date(task.due_date);
                const diffDays = Math.ceil((due - today) / (1000*60*60*24));
                let urgencyClass = '';
                if (task.status !== 'Done') {
                  if (diffDays < 0) urgencyClass = 'overdue';
                  else if (diffDays <= 3) urgencyClass = 'due-soon';
                }
              %>
              <tr class="<%= urgencyClass %>">
                <td><%= task.title %></td>
                <td><span class="badge badge-type"><%= task.task_type %></span></td>
                <td><%= task.module %></td>
                <td>
                  <%= due.toLocaleDateString('en-SG', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  <% if (urgencyClass === 'overdue') { %>
                    <span class="badge badge-danger">Overdue</span>
                  <% } else if (urgencyClass === 'due-soon') { %>
                    <span class="badge badge-warning">Due Soon</span>
                  <% } %>
                </td>
                <td>
                  <span class="badge badge-status badge-<%= task.status.toLowerCase().replace(' ', '-') %>">
                    <%= task.status %>
                  </span>
                </td>
                <td class="action-btns">
                  <a href="/tasks/edit/<%= task.task_id %>" class="btn btn-sm">Edit</a>
                  <form action="/tasks/delete/<%= task.task_id %>" method="POST" style="display:inline"
                    onsubmit="return confirm('Delete this task?')">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</body>
</html>