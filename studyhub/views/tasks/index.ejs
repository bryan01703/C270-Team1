<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>StudyHub - Assignment Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-5">
    <h1 class="mb-4">📚 Assignment Tracker</h1>

    <!-- Add Task Form -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Add New Task</h5>
            <form action="/tasks/add" method="POST">
                <div class="mb-3">
                    <input type="text" name="title" class="form-control" placeholder="Task Title" required>
                </div>
                <div class="mb-3">
                    <input type="text" name="module" class="form-control" placeholder="Module (e.g. C270)" required>
                </div>
                <div class="mb-3">
                    <input type="date" name="due_date" class="form-control" required>
                </div>
                <div class="mb-3">
                    <select name="status" class="form-select">
                        <option>Not Started</option>
                        <option>In Progress</option>
                        <option>Done</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Add Task</button>
            </form>
        </div>
    </div>

    <!-- Task List -->
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">My Tasks</h5>
            <table class="table">
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Module</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% tasks.forEach(task => { %>
                    <tr>
                        <td><%= task.title %></td>
                        <td><%= task.module %></td>
                        <td><%= task.due_date %></td>
                        <td><%= task.status %></td>
                        <td>
                            <form action="/tasks/delete/<%= task.id %>" method="POST">
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

</body>
</html>