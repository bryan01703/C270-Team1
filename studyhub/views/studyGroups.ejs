<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <title>Study Groups</title>
</head>

<body>
    <div class="container mt-5">
        <h2 class="mb-4">Study Groups</h2>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Group Name</th>
                        <th>Module</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Location</th>
                        <th>Members</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < studyGroups.length; i++) { %>
                    <tr>
                        <td> 
                            <a href="/studygroups/<%= studyGroups[i].id %>">
                                <%= studyGroups[i].groupName %>
                            </a>
                        </td>
                        <td><%= studyGroups[i].module %></td>
                        <td><%= studyGroups[i].date %></td>
                        <td><%= studyGroups[i].time %></td>
                        <td><%= studyGroups[i].location %></td>
                        <td><%= studyGroups[i].members %></td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
</body>
</html>